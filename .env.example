# Environment variables for Kidcol Flutter app

# API configuration
base_url=https://gateway.ajianaz.dev
gateway_key=your_gateway_key_here

# Limit the number of collections allowed for free users
limit_free=10

# Default account type (options: free/paid)
account_type=free

# Enable device and WhatsApp verification for paid users (options: true/false)
enable_verification=false